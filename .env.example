# =============================================
# mac-valuer 環境變數設定範本
# 使用方法：cp .env.example .env，然後填入真實值
# 注意：.env 本身不應提交到版本控制
# =============================================

# --- LLM ---
# Google AI Studio 取得：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 使用的 Gemini 模型 ID（預設即可，需要時再修改）
GEMINI_MODEL=gemini-3.5-flash-lite

# --- 資料庫 ---
# 本地開發（SQLite）：保持以下預設即可
DATABASE_URL=sqlite:///./mac_deals.db

# 上雲端時改成 PostgreSQL（P3/P4 階段）：
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/mac_valuer

# --- 爬蟲行為（通用）---
# PTT 並行請求數上限（建議 3–5，避免被 PTT 封鎖）
SCRAPER_CONCURRENCY=5

# PTT 每次請求間隔秒數
SCRAPER_DELAY_SECONDS=1

# PTT 往回抓幾小時內的文章（預設 36）。pipeline 一天跑一次，多出的時數吸收 cron 延遲
PTT_LOOKBACK_HOURS=36
# PTT 最多翻幾頁看板列表（預設 40，每頁 20 篇）。撞到上限會記 warning，代表有漏抓
PTT_MAX_PAGES=40

# --- 蝦皮：聯盟行銷 Open API（首選路徑）---
# 申請：https://affiliate.shopee.tw/ → 開發者 / Open API → 取得 AppID 與 Secret
# 只要這兩項有填，ShopeeScraper 就會自動改走官方 GraphQL API：
# 不需要瀏覽器、不需要 cookie、不會被驗證碼擋，GitHub Actions 也能跑。
# 兩項留空則自動退回下方的瀏覽器爬蟲。
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# API 端點，僅在蝦皮更動網址時才需要覆寫
# SHOPEE_AFFILIATE_ENDPOINT=https://open-api.affiliate.shopee.tw/graphql

# 搜尋關鍵字，逗號分隔可查多組（預設依 spec 為「二手 MacBook」）。
# 瀏覽器路徑與 API 路徑都讀這一項。要收桌機就加上「二手 Mac mini,二手 Mac Studio」；
# 瀏覽器路徑每多一個關鍵字就多 3 次搜尋頁載入，同一 session 內請求越多越容易被判為爬蟲。
SHOPEE_KEYWORDS=二手 MacBook

# 每個關鍵字最多翻幾頁 / 每頁幾筆
SHOPEE_API_PAGES=3
SHOPEE_API_LIMIT=50

# 每頁請求間隔秒數
SHOPEE_API_DELAY=1

# --- 蝦皮：瀏覽器爬蟲（退路，僅本機可用）---
# 精簡模式：只讀搜尋頁，不逐一開啟商品詳情頁。
# 詳情頁模式每次執行約 33 次頁面載入，是被蝦皮判定為爬蟲的主因；
# 精簡模式降到 3 次，代價是沒有商品描述與多規格價格。
# 設為 false 可還原舊行為（資料較完整，但被驗證碼攔截的機率高）。
SHOPEE_SKIP_DETAILS=true

# 精簡模式只看得到每個商品「最便宜的規格」的價格。同一個商品的規格價差超過這個倍數
# （例如 5,000 ~ 18,000）代表標題底下賣的是不同世代的機器，最便宜的價格不屬於標題
# 領頭的那台，整筆略過。1.5 可容納同機型 256G→1T 的正常價差。
SHOPEE_MAX_VARIANT_SPREAD=1.5

# 注意：此路徑無法在 GitHub Actions 上運作 —— 蝦皮封鎖機房 IP，
# 且登入 session 無法帶到臨時 runner 上。請改用本機排程：
#   scripts/run_local_shopee.ps1
# 隨機延遲下限（秒）：模擬人類瀏覽行為，建議不低於 3
SHOPEE_MIN_DELAY=3

# 隨機延遲上限（秒）
SHOPEE_MAX_DELAY=8

# 蝦皮 Playwright 並行請求數上限（stealth 模式下建議 ≤ 2）
SHOPEE_CONCURRENCY=2

# 登入 session 儲存檔案（第一次需 SHOPEE_HEADLESS=false 手動登入後自動儲存）
SHOPEE_STATE_PATH=shopee_state.json

# 無頭模式（排程 cron 用 true；第一次登入用 false）
SHOPEE_HEADLESS=false

# 撞到登入牆時是否等人在鍵盤前解驗證。排程（run_local_scrape.ps1）設成 false，
# 讓它直接失敗並通報 Discord，而不是卡在 input() 直到排程逾時。
# 與 SHOPEE_HEADLESS 無關：有視窗的排程一樣沒人值守
SHOPEE_INTERACTIVE=true

# --- Streamlit keep-alive（選用）---
# src/scripts/wake_streamlit.py 要喚醒的 app 網址，預設 mac-valuer.streamlit.app
STREAMLIT_APP_URL=

# --- Discord 推播（選用）---
# Discord 頻道設定 → 整合 → Webhook → 複製 Webhook URL
DISCORD_WEBHOOK_URL=

# VFM 推播閾值，只有 vfm_score > threshold 才會觸發推播（預設 500）。
# 只適用於筆電（MacBook）。
ALERT_VFM_THRESHOLD=500

# 桌機（Mac mini／Mac Studio）的推播閾值。桌機沒有螢幕與電池，同一顆晶片的分數
# 天生比筆電高（M4 Mac mini 全新價就約 740 分），不能沿用上面的值。
# 留空＝桌機一律不推播；累積兩週資料、看過 Dashboard 的桌機 p75 之後再填。
ALERT_VFM_THRESHOLD_DESKTOP=

# Dashboard 每頁筆數。設小值可讓瀏覽器測試用少量測資翻頁。
PAGE_SIZE=20

# --- 下架判定 ---
# 物件連續幾天沒再被看到才標記為 unavailable（預設 14）
# 爬蟲取得的都是取樣視窗而非完整庫存，不可用「本次沒看到」判定下架
STALE_DAYS=14
# 每次執行、每個來源最多回查幾筆在架物件（PTT、旋轉拍賣；預設 200）
# 回查會直接開物件頁：404/410 標為下架、售出標為 sold，不必等 STALE_DAYS
RECHECK_MAX_PER_SOURCE=200

# --- 品牌 ---
# SainTech 頻道網址；填了才會在頁尾顯示連結，留空則不顯示
SAINTECH_URL=

# --- 旋轉拍賣（Carousell）---
# 純 HTTP，無反爬牆，可在 GitHub Actions 上執行。
# 只使用對方 robots.txt 允許的入口：sitemap 與 /p/ 商品頁；
# 不碰 /search/ 與任何帶查詢字串的網址。
CAROUSELL_SITEMAP=https://tw.carousell.com/sitemaps/products/tw-computers-tech.xml

# 每次執行抓取最新的幾筆商品頁（sitemap 依 lastmod 排序）
CAROUSELL_MAX_ITEMS=30

# 每次商品頁請求之間的間隔秒數
CAROUSELL_DELAY=1.5

# 單次執行最多解析幾筆新物件，避免首次部署時一次燒光額度
MAX_LLM_CALLS_PER_RUN=100
# 每次執行最多重新解析幾筆既有資料。解析讀的是資料庫裡存的文字，
# 成本隨資料庫總量成長而非隨新物件成長，不設上限會自己撞上 Gemini 每日 500 次。
MAX_REPAIR_CALLS_PER_RUN=50

# --- Gemini 節流 ---
# 每分鐘最多送出幾次 LLM 請求。免費方案 Gemini 3.5/3.1 Flash Lite 為 15 RPM，
# 預設 13 是刻意留餘裕——貼著上限跑，稍有抖動就會吃到 429。
# 每日上限 500 次（非 Lite 的 Flash 系列只有 20 次，不適合本專案）。
GEMINI_RPM=13

# 單次 LLM 請求最多等幾秒。SDK 預設是永遠等；模型過載時曾有一個請求不回應，
# 卡到排程的一小時上限被砍，連 Discord 通知都沒發。逾時的那筆下次再解析。
GEMINI_TIMEOUT_SECONDS=30

# 模型代號。3.5 Flash Lite 與 3.1 Flash Lite 額度相同（15 RPM / 500 RPD）。
GEMINI_MODEL=gemini-3.5-flash-lite
